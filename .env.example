# 复制本文件为 .env，并按需修改密码后再部署

# MySQL root 密码
MYSQL_ROOT_PASSWORD=change_this_root_password

# 业务数据库与账号
DB_NAME=bookmarks
DB_USER=bookmarks
DB_PASSWORD=change_this_password

# 前端对外端口（默认 8080，避免与服务器上其它服务的 80 端口冲突）
APP_PORT=8080

# JWT 签名密钥（务必改成随机串：openssl rand -hex 32；改它会令所有已登录用户失效）
SECRET_KEY=change_me_random_hex

# 管理员账号（可选）：首次启动时自动创建，并把迁移前的存量收藏归到它名下
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_admin_password
